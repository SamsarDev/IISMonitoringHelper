{
  "DurationHours": 72,
  "SampleIntervalSeconds": 15,
  "CheckpointIntervalMinutes": 60,
  "OutputDirectory": "./monitor-output",
  "DbPorts": [1433],
  "AppPoolFilter": [],
  "NodeIgnorePatterns": [],
  "AnomalyCooldownSeconds": 300,
  "EventLogLookbackMinutes": 5,
  "Thresholds": {
    "ConnectionPoolWarningCount": 75,
    "ConnectionPoolCriticalCount": 95,
    "DbEstablishedWarningCount": 80,
    "DbEstablishedCriticalCount": 100,
    "DbCloseWaitWarningCount": 5,
    "DbCloseWaitCriticalCount": 15,
    "TimeWaitChurnCount": 200,
    "HungRequestThresholdMs": 10000,
    "CriticalHungRequestThresholdMs": 30000,
    "AspNetQueueWarningCount": 20,
    "HttpQueueWarningCount": 20,
    "ThreadContentionPerSecWarning": 25.0,
    "ExceptionsPerSecWarning": 20.0,
    "HighGcTimeWarningPercent": 20.0,
    "HighGcTimeCriticalPercent": 40.0,
    "NodeZombieUptimeMinutes": 30,
    "NodeStalledCpuDeltaMs": 100,
    "IncidentMergeGapSeconds": 180
  }
}
